@startuml VengeanceReborn_Classes
' =====================================================================
' Vengeance Reborn - Diagrama de Classes (VERSÃO FINAL)
' Gerado a partir da análise dos arquivos .py do projeto atual
' (herança, composição, agregação e dependências).
' Abra no VS Code com a extensão PlantUML (Alt+D para pré-visualizar)
' - requer Java + Graphviz instalados.
'
' Legenda:  <|--  herança      *--  composição     o--  agregação
'           -->   associação   ..>  dependência (usa / recebe por parâmetro)
' =====================================================================

title Vengeance Reborn - Diagrama de Classes (versão final)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam ClassBackgroundColor #FDFDFD
skinparam ClassBorderColor #444444
skinparam ArrowColor #333333
skinparam DefaultFontSize 12
skinparam nodesep 40
skinparam ranksep 60

hide empty members

' ---------------------------------------------------------------------
' config
' ---------------------------------------------------------------------
package "config" #EEEEEE {
  class settings <<module>> {
    {static} SCREEN_WIDTH, SCREEN_HEIGHT, FPS
    {static} GRAVITY, PLAYER_*, DASH_*
    {static} BASIC_ENEMY_*, RANGED_ENEMY_*, FLYING_ENEMY_*
    {static} WALL_SENTINEL_*, BOSS_*
    {static} MOVING_PLATFORM_*, CHECKPOINT_*, COIN_VALUE
    {static} STATE_MENU, STATE_PLAYING, STATE_PAUSED
    {static} STATE_SHOP, STATE_GAME_OVER, STATE_VICTORY
    {static} STATE_BOSS_INTRO
  }
}
note right of settings
  Usado por praticamente todas as classes
  (setas omitidas para não poluir o diagrama).
end note

' ---------------------------------------------------------------------
' core
' ---------------------------------------------------------------------
package "core" #E8F0FE {
  class Game {
    + screen : Surface
    + world_surface : Surface
    + clock : Clock
    + frame_dt_ms : float
    + states : StateMachine
    + input : InputManager
    + audio : SoundManager
    + music : MusicManager
    + sfx : AudioDirector
    + menu_screen : MenuScreen
    + hud : HUD
    + game_over_screen : GameOverScreen
    + victory_screen : VictoryScreen
    + shop : Shop
    + pause_menu : PauseMenu
    + story : StoryPopup
    + particles : ParticleSystem
    + debug_overlay : DebugOverlay
    + boss_intro : VideoCutscene
    + level : Level
    + player : Player
    + respawn_system : RespawnSystem
    + camera_x : int
    + shake_timer : int
    + shake_magnitude : float
    + play_frames : int
    + debug_mode : bool
    + running : bool
    - _prev_on_ground : bool
    - _prev_health : int
    - _victory_sound_played : bool
    - _victory_timer : int
    - _autosave_frames : int
    - _save_notice : int
    --
    + run()
    + trigger_shake(magnitude, frames)
    + start_new_game()
    + continue_game()
    + refresh_saved_run()
    + save_run(reason)
    + enter_boss_level()
    + restart_attempt()
    + return_to_menu()
    - _begin_session(level, player, core_pos, play_frames)
    - _tick_autosave()
    - _save_on_exit()
    - _start_boss_intro() : bool
    - _update_boss_intro()
    - _begin_boss_fight()
    - _reset_boss_attacks()
    - _near_shop() : bool
    - _update_shake()
    - _process_events()
    - _update()
    - _update_menu()
    - _update_playing()
    - _update_shop()
    - _update_pause()
    - _update_camera()
    - _draw_save_notice()
    - _draw()
  }

  class StateMachine {
    + current : str
    + previous : str
    --
    + change(new_state)
    + is_(state) : bool
    + revert()
  }

  class InputManager {
    - _held : set
    - _pressed_this_frame : set
    - _released_this_frame : set
    - _mouse_held : set
    - _mouse_pressed_this_frame : set
    - _mouse_released_this_frame : set
    --
    + handle_event(event)
    + end_frame()
    + is_held(key) : bool
    + is_pressed(key) : bool
    + is_released(key) : bool
    + mouse_pressed(button) : bool
    + mouse_world_x(camera_x) : int
    + move_left() : bool
    + move_right() : bool
    + jump_pressed() : bool
    + jump_held() : bool
    + attack_pressed() : bool
    + dash_pressed() : bool
    + interact_pressed() : bool
    + pause_pressed() : bool
    + confirm_pressed() : bool
    + debug_toggle_pressed() : bool
    + up_pressed() : bool
    + down_pressed() : bool
    + left_pressed() : bool
    + right_pressed() : bool
  }

  class DebugOverlay {
    + font : Font
    + panel_font : Font
    --
    + draw_world(surf, camera_x, level, player)
    + draw_panel(screen, fps, player, camera_x, mouse_screen_pos, shake_offset)
    - _draw_grid(surf, camera_x)
    - _draw_rect(surf, camera_x, rect, color)
    - _draw_hitboxes(surf, camera_x, level, player)
  }

  class save <<module>> {
    + {static} save_path() : str
    + {static} read_save() : dict
    + {static} save_game(player_stats, run) : bool
    + {static} load_game(player_stats) : bool
    + {static} delete_save()
    - {static} _parse(raw)
    - {static} _read_file(path)
  }

  class run_state <<module>> {
    + {static} capture_run(game) : dict
    + {static} restore_run(run, stats) : tuple
    + {static} summarize(run, stats) : dict
    + {static} biome_of(level, x) : str
    - {static} _capture_enemy(e)
    - {static} _capture_platforms(level)
    - {static} _capture_stalactites(level, player, dead)
    - {static} _capture_boss(boss)
    - {static} _apply_world(level, run)
    - {static} _valid_core(level, data)
    - {static} _safe_spot(level, rect)
  }

  class main <<module>> {
    + {static} main()
  }
}

