  class Mix {
    --
    + add(sig, t, gain, pan)
    + out()
  }

  class Particle <<__slots__>> {
    + x : float
    + y : float
    + vx : float
    + vy : float
    + life : int
    + max_life : int
    + size : int
    + color : tuple
    + gravity : float
    --
    + update() : bool
    + draw(surface, camera_x)
  }

  class ParticleSystem {
    + particles : List<Particle>
    --
    + update()
    + draw(surface, camera_x)
    + emit_hit(x, y, color, count)
    + emit_coin(x, y)
    + emit_dust(x, y, count)
    + emit_death(x, y)
    + emit_checkpoint(x, y)
    + emit_dash_trail(x, y)
  }

  class collision <<module>> {
    + {static} move_and_collide(entity_rect, vel_x, vel_y, solids) : tuple
    + {static} rect_collides_any(rect, solids) : bool
    + {static} ground_exists_below(rect, direction, solids, probe_distance) : bool
    + {static} segment_hits_rect(start, end, rect) : bool
    + {static} line_of_sight_clear(start, end, solids) : bool
  }

  class combat <<module>> {
    + {static} resolve_player_attack(player, enemies, particles) : tuple
  }

  class progression <<module>> {
    + {static} upgrade_description(kind) : str
    + {static} apply_full_heal_on_upgrade(player)
  }
}

' ---------------------------------------------------------------------
' screens
' ---------------------------------------------------------------------
package "screens" #EAF2F8 {
  class MenuScreen {
    + {static} OPTIONS : List<str>
    + {static} CONFIRM_OPTIONS : List<str>
    + {static} MESSAGE_FRAMES : int
    + backdrop : Surface
    + saved : dict
    + selected_index : int
    + confirming_new : bool
    + confirm_index : int
    + message : str
    --
    + set_saved_run(summary)
    + has_saved_run() : bool
    + move_selection(delta)
    + selected_option() : str
    + begin_confirm_new()
    + cancel_confirm()
    + toggle_confirm()
    + confirm_is_replace() : bool
    + show_message(text)
    + update()
    + draw(surface)
  }

  class menu_helpers <<module>> {
    + {static} get_font(size, serif, bold) : Font
    + {static} draw_text_glow(...)
    + {static} draw_panel(...)
    + {static} draw_divider(...)
    + {static} draw_coin_icon(...)
    + {static} draw_key_chip(...)
    + {static} vertical_gradient(...)
    + {static} make_vignette(...)
    + {static} load_backdrop()
  }

  class HUD {
    + font : Font
    + small_font : Font
    + big_font : Font
    --
    + draw(surface, player, level)
    + draw_prompt(surface, text)
    + draw_shop(surface, player, shop)
    + handle_shop_click(pos, player, shop)
    - _draw_minimap(surface, player, level)
    - _draw_health_bar(surface, player)
    - _draw_coins(surface, player)
    - _draw_dash(surface, player)
    - _draw_sword_card(surface, rect, sword_id, player, selected)
    - _draw_upgrade_card(surface, rect, kind, player, selected)
    - _draw_heal_card(surface, rect, player, selected)
  }

  class GameOverScreen {
    + {static} FADE_FRAMES : int
    + MIN_DISPLAY_FRAMES : int
    + timer : int
    --
    + reset()
    + update()
    + ready_to_continue() : bool
    + draw(surface, player)
  }

  class PauseMenu {
    + {static} OPTIONS : List<str>
    + {static} ROW_H : int
    + selected_index : int
    --
    + reset_selection()
    + move_selection(delta)
    + selected_option() : str
    + draw(surface)
  }

  class StoryPopup {
    + {static} DISPLAY_FRAMES : int
    + {static} FADE_FRAMES : int
    + text : str
    + timer : int
    --
    + show(text)
    + update()
    + draw(surface)
    - _wrap(text)
  }

  class VictoryScreen {
    + {static} FADE_FRAMES : int
    --
    + draw(surface, player)
  }

  class VideoCutscene {
    + path : str
    + fps : float
    + total_frames : int
    + duration : float
    + finished : bool
    + frames_mode : bool
    --
    + start()
    + stop()
    + elapsed() : float
    + update(skip) : bool
    + draw(screen)
    - _start_frames()
    - _start_audio()
  }
}

